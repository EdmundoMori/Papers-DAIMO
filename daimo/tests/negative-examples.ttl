@prefix bad:   <https://example.org/daimo-negative/> .
@prefix daimo: <https://w3id.org/pionera/daimo#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix it6:   <http://data.europa.eu/it6/> .
@prefix mls:   <http://www.w3.org/ns/mls#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix edc:   <https://w3id.org/edc/v0.0.1/ns/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Negative-test KG: deliberately violates each cross-class invariant
# (INV-1 through INV-9) plus the per-class ExecutionAuthorization
# completeness rules for the authorization/agreement separation
# (DAIMO-ISSUE-02). Expected SHACL result: conforms=False, with a
# dedicated focus node firing each invariant.
#
# Every focus node that violates an invariant is named bad:INV1-foo,
# bad:INV2-foo, etc. (and bad:AUTH-* for the authorization/agreement
# per-class rules), so the negative-test script can assert which
# invariants fired.
#################################################################

# Shared minimal dependencies the bad data references.

bad:ctx-a a edc:ParticipantContext .
bad:ctx-b a edc:ParticipantContext .

bad:agent-alice a foaf:Agent .
bad:agent-bob   a foaf:Agent .

# Well-formed ODRL agreements the authorizations below derive from, so that the
# INV-1/INV-2/INV-4 authorizations fire ONLY their intended invariant and not the
# derivedFromAgreement/INV-9 rules.
bad:agreement-alice a odrl:Agreement ;
    odrl:assigner bad:agent-bob ;
    odrl:assignee bad:agent-alice ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] .

bad:agreement-bob a odrl:Agreement ;
    odrl:assigner bad:agent-alice ;
    odrl:assignee bad:agent-bob ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] .

bad:some-model a it6:MachineLearningModel ;
    dct:title "Some model"@en ;
    dct:identifier "some-model" ;
    odrl:hasPolicy [ a odrl:Offer ; odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] ] .

bad:other-model a it6:MachineLearningModel ;
    dct:title "Other model"@en ;
    dct:identifier "other-model" ;
    odrl:hasPolicy [ a odrl:Offer ; odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] ] .

bad:algo a mls:Algorithm .
bad:flow a it6:Flow ; dct:hasVersion "1.0" .

bad:infra a it6:ComputerInfrastructure .

#################################################################
# INV-1 violation: DerivedArtifact's underAuthorization does NOT
# authorize the run it derivedFromRun points to.
#################################################################

bad:INV1-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;
    prov:startedAtTime "2026-05-01T08:00:00Z"^^xsd:dateTime .

bad:INV1-other-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;
    prov:startedAtTime "2026-05-01T09:00:00Z"^^xsd:dateTime .

bad:INV1-auth a daimo:ExecutionAuthorization ;
    rdfs:label "INV-1 authorization (covers the wrong run)"@en ;
    daimo:derivedFromAgreement bad:agreement-alice ;
    daimo:grantedTo bad:agent-alice ;
    daimo:authorizesRun bad:INV1-other-run ;       # authorizes a DIFFERENT run
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .

bad:INV1-artifact a daimo:DerivedArtifact ;
    dct:title "INV-1 violation: unauthorized derivation"@en ;
    daimo:derivedFromRun bad:INV1-run ;            # produced by INV1-run
    daimo:underAuthorization bad:INV1-auth .       # under an auth that doesn't cover INV1-run

#################################################################
# INV-2 violation: run's associated agent is NOT the grantee of the
# authorization that covers the run.
#################################################################

bad:INV2-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;       # associated with Alice
    prov:startedAtTime "2026-05-02T08:00:00Z"^^xsd:dateTime .

bad:INV2-auth a daimo:ExecutionAuthorization ;
    rdfs:label "INV-2 authorization (granted to the wrong agent)"@en ;
    daimo:derivedFromAgreement bad:agreement-bob ; # agreement assignee = Bob (matches grantee)
    daimo:grantedTo bad:agent-bob ;                # granted to Bob, not Alice
    daimo:authorizesRun bad:INV2-run ;
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .

#################################################################
# INV-3 violation: deployment's service does NOT servesModel the same
# model the deployment deploysModel.
#################################################################

bad:INV3-deployment a daimo:ModelDeployment ;
    rdfs:label "INV-3 deployment (service serves a different model)"@en ;
    daimo:deploysModel bad:some-model ;
    daimo:exposedAs bad:INV3-svc ;
    daimo:onInfrastructure bad:infra ;
    daimo:hasIOContract [ a daimo:IOContract ;
                          daimo:inputFormat "application/json" ;
                          daimo:outputFormat "application/json" ;
                          daimo:authMethod "api-key" ] .

bad:INV3-svc a dcat:DataService ;
    dct:title "Service for a different model"@en ;
    dcat:endpointURL <https://api.example.org/other/v1> ;
    it6:servesModel bad:other-model .              # serves the WRONG model

#################################################################
# INV-4 violation: authorization's expiresAt is BEFORE a run it
# authorizes has even started.
#################################################################

bad:INV4-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;
    prov:startedAtTime "2026-05-15T08:00:00Z"^^xsd:dateTime .   # started May 2026

bad:INV4-auth a daimo:ExecutionAuthorization ;
    rdfs:label "INV-4 authorization (expired before run started)"@en ;
    daimo:derivedFromAgreement bad:agreement-alice ;
    daimo:grantedTo bad:agent-alice ;
    daimo:authorizesRun bad:INV4-run ;
    daimo:expiresAt "2025-01-01T00:00:00Z"^^xsd:dateTime .       # expired January 2025

#################################################################
# INV-5 violation: Offering's offersModel is NOT a target of its
# attached policy.
#################################################################

bad:INV5-model a it6:MachineLearningModel ;
    dct:title "INV-5 offered model"@en ;
    dct:identifier "inv5-model" ;
    odrl:hasPolicy bad:INV5-policy .

bad:INV5-policy a odrl:Offer ;
    odrl:assigner bad:agent-alice ;
    odrl:target bad:some-other-model-not-the-offered-one ;     # targets a DIFFERENT model
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] ;
    dct:title "INV-5 policy (wrong target)"@en .

bad:INV5-offering a daimo:AIAssetOffering ;
    dct:title "INV-5 offering"@en ;
    daimo:offersModel bad:INV5-model ;
    daimo:offeredBy bad:agent-alice ;
    daimo:hasOfferPolicy bad:INV5-policy .

#################################################################
# INV-6 violation: Offering's offeredBy differs from the
# odrl:assigner of its attached policy.
#################################################################

bad:INV6-model a it6:MachineLearningModel ;
    dct:title "INV-6 offered model"@en ;
    dct:identifier "inv6-model" ;
    odrl:hasPolicy bad:INV6-policy .

bad:INV6-policy a odrl:Offer ;
    odrl:assigner bad:agent-bob ;                                # assigned by Bob
    odrl:target bad:INV6-model ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] ;
    dct:title "INV-6 policy (mismatched assigner)"@en .

bad:INV6-offering a daimo:AIAssetOffering ;
    dct:title "INV-6 offering"@en ;
    daimo:offersModel bad:INV6-model ;
    daimo:offeredBy bad:agent-alice ;                            # offering says Alice
    daimo:hasOfferPolicy bad:INV6-policy .

#################################################################
# INV-7 violation: an I/O contract of the deployment points
# (daimo:forService) to a service that the deployment does NOT expose.
# The deployment still exposes one service that IS correctly contracted,
# so INV-8 does not fire here — only INV-7.
#################################################################

bad:INV7-svc-exposed a dcat:DataService ;
    dct:title "INV-7 exposed service"@en ;
    dcat:endpointURL <https://api.example.org/inv7/exposed> ;
    it6:servesModel bad:some-model .

bad:INV7-svc-foreign a dcat:DataService ;
    dct:title "INV-7 foreign service (not exposed by the deployment)"@en ;
    dcat:endpointURL <https://api.example.org/inv7/foreign> ;
    it6:servesModel bad:some-model .

bad:INV7-contract-ok a daimo:IOContract ;
    daimo:forService bad:INV7-svc-exposed ;
    daimo:inputFormat "application/json" ;
    daimo:outputFormat "application/json" ;
    daimo:authMethod "api-key" .

bad:INV7-contract-foreign a daimo:IOContract ;
    daimo:forService bad:INV7-svc-foreign ;      # service NOT exposed by INV7-deployment
    daimo:inputFormat "application/json" ;
    daimo:outputFormat "application/json" ;
    daimo:authMethod "api-key" .

bad:INV7-deployment a daimo:ModelDeployment ;
    rdfs:label "INV-7 deployment (contract targets a non-exposed service)"@en ;
    daimo:deploysModel bad:some-model ;
    daimo:exposedAs bad:INV7-svc-exposed ;
    daimo:onInfrastructure bad:infra ;
    daimo:hasIOContract bad:INV7-contract-ok , bad:INV7-contract-foreign .

#################################################################
# INV-8 violation: the deployment exposes a service (daimo:exposedAs)
# that has NO I/O contract pointing to it via daimo:forService.
# The other exposed service IS contracted, and no contract points to a
# foreign service, so INV-7 does not fire here — only INV-8.
#################################################################

bad:INV8-svc-with-contract a dcat:DataService ;
    dct:title "INV-8 service with contract"@en ;
    dcat:endpointURL <https://api.example.org/inv8/a> ;
    it6:servesModel bad:some-model .

bad:INV8-svc-orphan a dcat:DataService ;
    dct:title "INV-8 exposed service with NO contract"@en ;
    dcat:endpointURL <https://api.example.org/inv8/b> ;
    it6:servesModel bad:some-model .

bad:INV8-contract a daimo:IOContract ;
    daimo:forService bad:INV8-svc-with-contract ;
    daimo:inputFormat "application/json" ;
    daimo:outputFormat "application/json" ;
    daimo:authMethod "api-key" .

bad:INV8-deployment a daimo:ModelDeployment ;
    rdfs:label "INV-8 deployment (exposes a service that has no I/O contract)"@en ;
    daimo:deploysModel bad:some-model ;
    daimo:exposedAs bad:INV8-svc-with-contract , bad:INV8-svc-orphan ;
    daimo:onInfrastructure bad:infra ;
    daimo:hasIOContract bad:INV8-contract .

#################################################################
# INV-9 violation: the authorization's grantee (daimo:grantedTo) is NOT an
# odrl:assignee of the odrl:Agreement it derives from. The run is associated
# with the grantee, so INV-2 does not fire — only INV-9.
#################################################################

bad:INV9-agreement a odrl:Agreement ;
    odrl:assigner bad:agent-bob ;
    odrl:assignee bad:agent-bob ;                  # agreement assigns terms to Bob
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] .

bad:INV9-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;       # run associated with Alice (= grantee)
    prov:startedAtTime "2026-05-20T08:00:00Z"^^xsd:dateTime .

bad:INV9-auth a daimo:ExecutionAuthorization ;
    rdfs:label "INV-9 authorization (grantee is not the agreement assignee)"@en ;
    daimo:derivedFromAgreement bad:INV9-agreement ; # agreement assignee = Bob
    daimo:grantedTo bad:agent-alice ;               # but grantee = Alice
    daimo:authorizesRun bad:INV9-run ;
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .

#################################################################
# AUTH-no-agreement: an ExecutionAuthorization with no
# daimo:derivedFromAgreement at all — violates the ExecutionAuthorizationShape
# minCount rule (authorization must derive from exactly one odrl:Agreement).
#################################################################

bad:AUTH-no-agreement-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;
    prov:startedAtTime "2026-05-21T08:00:00Z"^^xsd:dateTime .

bad:AUTH-no-agreement a daimo:ExecutionAuthorization ;
    rdfs:label "authorization without a source agreement"@en ;
    daimo:grantedTo bad:agent-alice ;
    daimo:authorizesRun bad:AUTH-no-agreement-run ;
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .
    # no daimo:derivedFromAgreement -> ExecutionAuthorizationShape violation

#################################################################
# AUTH-bad-agreement: an ExecutionAuthorization whose
# daimo:derivedFromAgreement points to a resource that is NOT a well-formed
# odrl:Agreement. Because daimo:derivedFromAgreement has rdfs:range
# odrl:Agreement, RDFS inference always entails the odrl:Agreement type on the
# target, so a bare sh:class check can never fire. The malformed-agreement smell
# is therefore caught by the conformance shape AgreementInDAIMOShape: this target
# lacks odrl:permission (required by the ODRL policy model for any agreement).
# It DOES declare odrl:assignee = Alice (= the grantee) so INV-9 stays quiet and
# the missing-permission rule is the sole violation on this node.
#################################################################

bad:AUTH-bad-agreement-notagreement
    dct:title "A resource wrongly used as the source agreement (no odrl:permission)"@en ;
    odrl:assignee bad:agent-alice .        # assignee present, but NO odrl:permission

bad:AUTH-bad-agreement-run a it6:Run ;
    mls:realizes bad:algo ;
    it6:hasFlow bad:flow ;
    prov:wasAssociatedWith bad:agent-alice ;
    prov:startedAtTime "2026-05-22T08:00:00Z"^^xsd:dateTime .

bad:AUTH-bad-agreement a daimo:ExecutionAuthorization ;
    rdfs:label "authorization whose source agreement is malformed (no permission)"@en ;
    daimo:derivedFromAgreement bad:AUTH-bad-agreement-notagreement ;  # not a well-formed Agreement
    daimo:grantedTo bad:agent-alice ;
    daimo:authorizesRun bad:AUTH-bad-agreement-run ;
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .
