@prefix seed:  <https://example.org/daimo-seedless/> .
@prefix daimo: <https://w3id.org/pionera/daimo#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix it6:   <http://data.europa.eu/it6/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Seed declared as xsd:string — must violate sh:datatype xsd:integer.
seed:task a it6:Task .
seed:dataset a dcat:Dataset ;
    dct:title "Bad-type dataset"@en .

seed:ctx-badtype a daimo:SharedEvaluationContext ;
    daimo:contextTask    seed:task ;
    daimo:contextDataset seed:dataset ;
    daimo:datasetVersion "2026.1" ;
    daimo:protocol       "holdout" ;
    daimo:randomSeed     "forty-two" .
