@prefix sc:    <https://example.org/daimo-scope/> .
@prefix daimo: <https://w3id.org/pionera/daimo#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix it6:   <http://data.europa.eu/it6/> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# In-scope incomplete Run: object of daimo:authorizesRun, missing flow,
# algorithm, agent and start time. Authorization and agreement are complete.
sc:agent a foaf:Agent ; rdfs:label "Scope-test consumer"@en .

sc:agreement a odrl:Agreement ;
    odrl:assignee sc:agent ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:use ] .

sc:run-incomplete a it6:Run ;
    rdfs:label "DAIMO-authorised run missing flow/algorithm/agent/start"@en .

sc:auth a daimo:ExecutionAuthorization ;
    daimo:derivedFromAgreement sc:agreement ;
    daimo:grantedTo sc:agent ;
    daimo:authorizesRun sc:run-incomplete ;
    daimo:expiresAt "2027-01-01T00:00:00Z"^^xsd:dateTime .
